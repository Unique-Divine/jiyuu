# Install the locked dependencies.
install:
    bun install --frozen-lockfile

# Link the mcp-discord command name to this checkout.
link:
    bun link

# Run the bun:test suite.
test:
    bun test ./src

# Typecheck, then validate entrypoint imports in an ignored build cache.
check:
    bun check
    bun build --target bun --packages external ./src/index.ts ./src/app.ts --outdir ./node_modules/.cache/mcp-check

# Launch the stdio server without changing its tool surface.
run:
    bun ./src/index.ts
