# Install the locked dependencies.
install:
    bun install --frozen-lockfile

# bun link only adds a symlink and bins under the global dir; it leaves the
# global package.json and bun.lock alone, so tracked dotfiles stay clean.

# Link the mcp-discord command name to this checkout.
link:
    bun link

# Run the bun:test suite. Keep --isolate: Bun's mock.module is process-wide,
# so without it one file's logger mock leaks into logger.test.ts.
test:
    bun test --isolate ./src

# Typecheck, then validate entrypoint imports in an ignored build cache.
check:
    bun check
    bun build --target bun --packages external ./src/index.ts ./src/app.ts --outdir ./node_modules/.cache/mcp-check

# Launch the stdio server without changing its tool surface.
run:
    bun ./src/index.ts
