{
  "name": "@uniquedivine/mcp-discord",
  "mcpName": "io.github.unique-divine/mcp-discord",
  "version": "1.3.9",
  "description": "Discord MCP server maintained in Jiyuu. Manages channels, forums, messages, reactions, roles, and webhooks through a Discord bot.",
  "main": "src/index.ts",
  "bin": {
    "mcp-discord": "src/index.ts"
  },
  "files": [
    "src/",
    "!src/**/*.test.ts",
    "!src/test-support/",
    "IMPORT.json",
    "NOTICE"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test --isolate ./src",
    "start": "bun src/index.ts",
    "start-app": "bun src/app.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "claude",
    "ai",
    "chatbot",
    "automation"
  ],
  "author": "Barry Yip <barry99625@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unique-Divine/jiyuu.git",
    "directory": "mcp/discord"
  },
  "bugs": {
    "url": "https://github.com/Unique-Divine/jiyuu/issues"
  },
  "homepage": "https://github.com/Unique-Divine/jiyuu/tree/main/mcp/discord",
  "engines": {
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.50"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "zod": "^3.25.13"
  },
  "packageManager": "bun@1.4.3",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "jiyuu": {
    "upstream": {
      "repository": "barryyip0625/mcp-discord",
      "package": "mcp-discord",
      "version": "1.3.8",
      "tag": "v1.4.0",
      "commit": "5c67e9d714971490aaedf8fab21753d7704bd4fa"
    },
    "site": {
      "tools": [
        "src/toolList.ts#toolList",
        "src/jiyuuMcpInfo.ts#MCP_INFO_TOOL"
      ],
      "env": [
        {
          "name": "DISCORD_TOKEN",
          "required": false,
          "secret": true
        },
        {
          "name": "JIYUU_MCP_NO_UPDATE_CHECK",
          "required": false,
          "secret": false
        }
      ]
    }
  }
}
