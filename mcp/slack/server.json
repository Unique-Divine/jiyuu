{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.unique-divine/mcp-slack",
  "title": "Slack MCP Server",
  "description": "Slack MCP server maintained in Jiyuu: session-based, local-first.",
  "websiteUrl": "https://github.com/Unique-Divine/jiyuu/tree/main/mcp/slack",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/Unique-Divine/jiyuu/main/mcp/slack/docs/assets/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/Unique-Divine/jiyuu",
    "source": "github",
    "subfolder": "mcp/slack"
  },
  "version": "4.4.3",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@uniquedivine/mcp-slack",
      "version": "4.4.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Slack xoxc- token from browser session",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SLACK_TOKEN"
        },
        {
          "description": "Slack xoxd- cookie from browser session",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SLACK_COOKIE"
        }
      ]
    }
  ]
}
