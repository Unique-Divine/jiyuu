{
  "name": "@jtalk22/slack-mcp",
  "mcpName": "io.github.jtalk22/slack-mcp-server",
  "version": "4.4.3",
  "description": "Slack MCP server maintained in Jiyuu",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "slack-mcp": "src/cli.js",
    "slack-mcp-server": "src/server.js",
    "slack-mcp-http": "src/server-http.js",
    "slack-mcp-web": "src/web-server.js",
    "slack-mcp-setup": "scripts/setup-wizard.js"
  },
  "scripts": {
    "test": "bun test ./test",
    "start": "bun src/server.js",
    "http": "bun src/server-http.js",
    "web": "bun src/web-server.js",
    "setup": "bun scripts/setup-wizard.js --setup",
    "hooks:setup": "bash scripts/setup-git-hooks.sh",
    "verify:owner-attribution": "bash scripts/check-owner-attribution.sh",
    "tokens:status": "bun scripts/token-cli.js status",
    "tokens:refresh": "bun scripts/token-cli.js refresh",
    "tokens:auto": "bun scripts/token-cli.js auto",
    "tokens:clear": "bun scripts/token-cli.js clear",
    "screenshot": "bun scripts/capture-screenshots.js",
    "build:social-preview": "bun scripts/build-social-preview.js",
    "build:public-pages": "bun scripts/generate-public-pages.js",
    "build:demo-mobile": "bun scripts/build-mobile-demo.js",
    "build:demo-mobile:gif": "bun scripts/build-mobile-demo.js --gif",
    "record-demo": "bun scripts/record-demo.js",
    "social-preview:update": "bun scripts/update-github-social-preview.js --headed",
    "bookmarklet": "bun scripts/generate-bookmarklet.js",
    "cf:browser": "bun scripts/cloudflare-browser-tool.js",
    "verify:attribution-guardrail": "bun scripts/verify-attribution-guardrail.js",
    "verify:public-pages": "bun scripts/verify-generated-public-pages.js",
    "verify:version-parity": "bun scripts/check-version-parity.js",
    "verify:public-surface": "bun scripts/check-public-surface-integrity.js",
    "verify:release-dry-run": "bun scripts/release-preflight.js",
    "smoke:browser": "bun scripts/browser-smoke.js",
    "smoke:browser:live": "bun scripts/browser-smoke.js --mode live"
  },
  "keywords": [
    "claude",
    "mcp",
    "model-context-protocol",
    "slack",
    "slack-api",
    "claude-desktop",
    "cli",
    "developer-tools",
    "mcp-server",
    "session-based",
    "claude-code",
    "gemini-cli",
    "local-first",
    "remote-mcp",
    "session-mirroring",
    "slack-mcp",
    "secure-by-default",
    "llm",
    "slack-integration",
    "ai-agents",
    "automation",
    "productivity",
    "oauth-free",
    "no-admin-approval",
    "cursor",
    "copilot",
    "windsurf",
    "codex-cli",
    "stealth-mode"
  ],
  "author": {
    "name": "Revasser",
    "email": "support@revasserlabs.com",
    "url": "https://mcp.revasserlabs.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unique-Divine/jiyuu.git",
    "directory": "mcp/slack"
  },
  "homepage": "https://github.com/Unique-Divine/jiyuu/tree/main/mcp/slack",
  "bugs": {
    "url": "https://github.com/Unique-Divine/jiyuu/issues"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^5.2.1"
  },
  "files": [
    "src/",
    "lib/",
    "public/index.html",
    "public/share.html",
    "scripts/setup-wizard.js",
    "scripts/token-cli.js",
    "scripts/apply-template.js",
    "templates/workflow-profiles/",
    "docs/SETUP.md",
    "docs/API.md",
    "docs/TROUBLESHOOTING.md",
    "docs/DEPLOYMENT-MODES.md",
    "docs/assets/icon.svg",
    "docs/assets/icon-512.png",
    "README.md",
    "LICENSE",
    "server.json",
    "smithery.yaml"
  ],
  "devDependencies": {
    "playwright": "^1.57.0"
  },
  "overrides": {
    "ip-address": "^10.1.1"
  },
  "private": true,
  "packageManager": "bun@1.4.3"
}
