# Suites that exercise the grammars and the extraction pipeline. test-all runs
# every suite.
default_suites := "edge_types_probe lang_contract cross_repo extraction"

# Install the pinned grammars (--from <archive> for a local file, --force).
grammars *ARGS:
    bun scripts/grammars-fetch.ts {{ARGS}}

# Build build/c/codebase-memory-mcp after installing the grammars.
build: grammars
    scripts/build.sh

# Run grammar suites plus the language-count and vendored-checksum checks.
test SUITES=default_suites: grammars
    scripts/test.sh --suites "{{SUITES}}"
    bash tests/test_language_count_contract.sh
    scripts/security-vendored.sh

# Run the full leg: contract checks, clean build, every C suite and the
# production-binary checks (over an hour).
test-all: grammars
    scripts/test.sh

# Test the grammar archive scripts.
scripts-test:
    bun test scripts

# Run the script tests, the build and the targeted suites.
check: scripts-test build test
