{
  "name": "@uniquedivine/tg-sai",
  "version": "0.2.0",
  "type": "module",
  "private": false,
  "description": "Sai Telegram admin audit and bootstrap CLI",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "tg-sai": "main.ts"
  },
  "scripts": {
    "start": "bun main.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "py-test": "uv run pytest session_string_generator_test.py"
  },
  "files": [
    "*.ts",
    "!*.test.ts",
    "!adminCheck.ts",
    "!testdata.ts",
    "!testPreload.ts",
    "telemetry/*.ts",
    "!telemetry/*.test.ts",
    "!telemetry/testEvents.ts",
    "telemetry/migrations/*.sql",
    "state/*.ts",
    "!state/*.test.ts",
    "state/migrations/*.sql",
    "*.py",
    "!*_test.py",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "RUNBOOK.md"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@mtcute/bun": "^0.30.1",
    "@mtcute/convert": "^0.30.1",
    "@mtcute/wasm": "^0.29.0",
    "commander": "^15.0.0"
  }
}
