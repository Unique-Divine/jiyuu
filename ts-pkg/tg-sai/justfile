# Use this justfile by
# (1) installing with "cargo install just"
# (2) running the "just" command.

# Displays available recipes when running `just` or `just list`.
[private]
list:
  #!/usr/bin/env bash
  just --list

# Install all dependencies
install:
  bun i --no-cache

alias i := install

# Run TypeScript tests
test:
  bun test

# Typecheck without emitting JavaScript
typecheck:
  bun run typecheck

# Run Python session generator tests
py-test:
  uv run --frozen pytest session_string_generator_test.py

# Check the Python session generator, its tests, and shared reporting helpers.
py-typecheck:
  uv run --frozen ty check . ../../scripts/python

# Check npm package compatibility with linter
lint:
  #!/usr/bin/env bash
  set -euo pipefail
  bunx publint

build:
  #!/usr/bin/env bash
  set -x
  echo "Build complete. (No op)"

alias b := build

# Pack, global-install the tarball, and smoke-test the CLI
smoke-test:
  #!/usr/bin/env bash
  set -euo pipefail

  package_version="$(jq -r .version package.json)"
  tarball="uniquedivine-tg-sai-${package_version}.tgz"

  rm -f ./*.tgz
  bun pm pack
  packed="$(ls -1 ./*.tgz | head -1)"
  if [[ "$(basename "${packed}")" != "${tarball}" ]]; then
    echo "unexpected tarball name: ${packed} (expected ${tarball})"
    exit 1
  fi

  bun add -g "./${tarball}"
  tg-sai --help
  tg-sai health

# Pinned npm for every registry step; newer npm changed validation and web auth, so bump only after testing.
npm := "bunx npm@12.2.0"

# Validate the package exactly as npm will publish it; fails on any npm warning
publish-check:
  #!/usr/bin/env bash
  set -euo pipefail
  out="$({{npm}} publish --dry-run --access public 2>&1)"
  if echo "$out" | grep -E 'npm (warn|error)'; then echo "Fix the npm warnings above before publishing."; exit 1; fi
  echo "$out" | grep -E 'name:|version:|total files:'

# Full pre-release validation (lint, tests, typecheck, npm dry run); run before `just publish`.
validate: lint test typecheck publish-check

# Publish fast: check npm login, unpublished version, and package validity, then upload (run `just validate` first).
publish:
  #!/usr/bin/env bash
  set -euo pipefail

  echo "[1/4] npm login"
  if ! user="$({{npm}} whoami 2>/dev/null)"; then
    echo "Not logged in to npm. Run: bunx npm@12.2.0 login --auth-type=web"
    exit 1
  fi
  echo "      logged in as ${user}"

  package="$(jq -r '.name + "@" + .version' package.json)"
  echo "[2/4] ${package} not yet on npm"
  if {{npm}} view "${package}" version >/dev/null 2>&1; then
    echo "${package} is already published; bump the version"
    exit 1
  fi

  echo "[3/4] npm package validation"
  just publish-check

  echo "[4/4] publishing; open the printed URL and choose 'remember me for 5 minutes'"
  BROWSER=true {{npm}} publish --access public

# Write CI-compatible diagnostics; checker/configuration failures remain fatal.
py-typecheck-report output_dir:
    uv run --frozen --no-sync python ../../scripts/python/typecheck_report.py --project "tg-sai Python" --output-dir "{{output_dir}}" . ../../scripts/python
