{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "types": [
      "bun",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "mdtoc"
    },
    {
      "path": "discord-nibiru"
    },
    {
      "path": "ts-pkg/bash"
    },
    {
      "path": "ts-pkg/jiyuu"
    },
    {
      "path": "ts-pkg/tg-sai"
    }
  ]
}
